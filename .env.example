# ====================================================================
# UTTARKUNTH STAYS: ENVIRONMENT CONFIGURATION
# Copy to .env for local development. Never commit secrets to version control.
# ====================================================================

# Environment Mode: 'development' | 'staging' | 'production'
# Strict separation: 'development' and 'staging' use Razorpay Sandbox only.
VITE_APP_ENV="development"

# 1. Supabase Backend (PostgreSQL, Auth, RLS, Storage)
# Development/Staging Supabase Project URL & Anon Public Key
VITE_SUPABASE_URL="https://your-dev-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# 2. Razorpay Payment Gateway (Test Mode Initially)
# Development & Staging MUST use Razorpay Test Key ID (rzp_test_...)
# Production keys (rzp_live_...) are strictly configured after legal registration.
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_secret_used_only_server_side"

# 3. Google Maps Platform
# Used for address autocomplete, geocoding, markers, and directions
VITE_GOOGLE_MAPS_API_KEY="AIzaSyPlaceholderGoogleMapsKey"

# 4. Uttarkunth Commission Configuration (Configurable rates)
# Year 1 Introductory Platform Commission (0.00%)
VITE_PLATFORM_INTRO_COMMISSION="0.00"
# Standard Platform Commission Afterward (10.00%)
VITE_PLATFORM_STANDARD_COMMISSION="10.00"

# 5. Core Platform
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
